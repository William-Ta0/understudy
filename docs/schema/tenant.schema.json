    "ConditionKind": {
      "description": "The error taxonomy. Every runtime condition the replay engine can detect falls in one class.\n\nbusiness        a legitimate answer the caller must handle (\"no such member\"). Not a failure.\nrecoverable     an incidental interruption the engine handles itself (interstitial, transient\n                host error, session expiry), within a bounded number of attempts.\nhuman_required  only a person can resolve it (supervisor override, MFA, ambiguous record).\n                The engine escalates and waits on the same live session.\nfatal           the app is broken or in an unknown state. Stop and surface a debuggable failure.",
      "enum": [
        "business",
        "recoverable",
        "human_required",
        "fatal"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
