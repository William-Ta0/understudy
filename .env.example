# Copy to .env and fill in. .env is gitignored; nothing in it is ever written to artifacts or logs.

# --- Target app credentials (synthetic operator accounts of the local Keystone mock) ---
KEYSTONE_LAKESHORE_USERNAME=tlr_demo
KEYSTONE_LAKESHORE_PASSWORD=keystone-demo
KEYSTONE_PINECREST_USERNAME=tlr_demo
KEYSTONE_PINECREST_PASSWORD=keystone-demo
# KEYSTONE_BASE_URL=http://127.0.0.1:8765

# --- Model access (only needed for discovery; replay never calls a model) ---
# UNDERSTUDY_LLM=anthropic            # anthropic | openai | scripted:<path>
# ANTHROPIC_API_KEY=
# UNDERSTUDY_MODEL=claude-opus-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# KEYSTONE_SUPERVISOR_CODE=   (only for the simulated supervisor in examples/operators)
